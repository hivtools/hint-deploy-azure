#!/usr/bin/env bash
# This script is designed to be sourced. It must not use `set -e` or `exit`,
# as either would take down the calling shell (e.g. an interactive terminal).
# Failures are reported with a non-zero return status instead; callers running
# under `set -e` will still stop as before.

# Check if AVENIR_ACCESS_TOKEN is set, and prompt if not
check_av_access_token() {
  if [ -z "$AVENIR_ACCESS_TOKEN" ]; then
    echo "AVENIR_ACCESS_TOKEN is not set."
    read -sp 'Please enter AVENIR_ACCESS_TOKEN: ' AVENIR_ACCESS_TOKEN
    export AVENIR_ACCESS_TOKEN
    echo
  fi
}

fetch_and_set_secret_env() {
  local AVENIR_AUTH_URL RESPONSE HTTP_CODE CONTENT FILTER KEY VALUES line
  local MISSING_KEYS=()

  # Check if at least one argument is provided
  if [ $# -lt 1 ]; then
    echo "Usage: source fetch_and_set_secret_env <key1> [key2] [key3] ..."
    return 1
  fi

  check_av_access_token

  AVENIR_AUTH_URL="https://api.authadmin.avenirhealth.org/v1/api/roles/fetchuserskeys"

  if ! RESPONSE=$(curl -s -w "\n%{http_code}" -X POST -H "Content-Type: application/json" -d "{\"keyAccessToken\": \"$AVENIR_ACCESS_TOKEN\"}" "$AVENIR_AUTH_URL"); then
    echo "Error: Failed to connect to $AVENIR_AUTH_URL"
    return 1
  fi

  HTTP_CODE=$(tail -n1 <<<"$RESPONSE") # get the last line
  CONTENT=$(sed '$ d' <<<"$RESPONSE")

  if [ "$HTTP_CODE" != "200" ]; then
    echo "Error: Failed to fetch data from URL. HTTP status code: $HTTP_CODE"
    echo "$CONTENT" # Print the response for debugging
    return 1
  fi

  # Build jq filter based on command line arguments
  FILTER=''
  for KEY in "$@"; do
    if [ -n "$FILTER" ]; then
      FILTER+=' or '
    fi
    FILTER+=".name == \"$KEY\""
  done

  # Extract values from the response and set environment variables
  if ! VALUES=$(jq -r ".keys[] | select($FILTER) | \"\(.name)=\(.value)\"" <<<"$CONTENT"); then
    echo "Error: Failed to parse response from Avenir Auth server"
    return 1
  fi

  # Check for missing keys
  for KEY in "$@"; do
    if ! grep -q "$KEY" <<<"$VALUES"; then
      MISSING_KEYS+=("$KEY")
    fi
  done

  if [ ${#MISSING_KEYS[@]} -gt 0 ]; then
    echo "Error: Required keys not found in the response: ${MISSING_KEYS[*]}"
    return 1
  fi

  # Set the extracted values as environment variables
  while IFS= read -r line; do
    export "$line"
  done <<<"$VALUES"

  echo "Environment read from Avenir Auth server"
}

fetch_and_set_secret_env "$@"
_fetch_status=$?
unset -f check_av_access_token fetch_and_set_secret_env

# `return` only works when sourced; fall back to `exit` if run directly
return $_fetch_status 2>/dev/null || exit $_fetch_status
